<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Conserva juntos usuarios y asociaciones, sin exportar la base de credenciales. -->
    <cloud-backup>
        <exclude domain="database" path="mygos.db" />
        <exclude domain="database" path="mygos.db-wal" />
        <exclude domain="database" path="mygos.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="mygos.db" />
        <exclude domain="database" path="mygos.db-wal" />
        <exclude domain="database" path="mygos.db-shm" />
    </device-transfer>
</data-extraction-rules>
